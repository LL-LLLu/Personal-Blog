# Docker Data and Logs
docker/data/
docker/logs/

# Dependency Directories
node_modules/
**/node_modules/

# Build Artifacts
dist/
**/dist/
target/
**/target/
weblog/**/target/ # Explicitly ignore target in weblog submodules

# IDE Files
.idea/
.vscode/
*.iml # IntelliJ module files
.DS_Store # Mac system files
**/.DS_Store # Mac system files anywhere in subdirectories

# Environment Files
.env
*.env

# Local AI Tool Settings
.claude/settings.local.json

# Lucene Index - should be generated, not tracked
weblog/E:\\\\java_workspace\\\\lucene-index/ # Ignore the whole directory, handling backslashes for git
weblog/lucene-index/ # Generic ignore for a lucene-index folder

# System Files
Thumbs.db

# https certs
docker/certbot/
docker/nginx/ssl/

# Application Logs
**/logs/
*.log
.crush/

# IP Geolocation Database Files (large binary files, download at runtime)
**/*.mmdb
**/*.xdb
**/geoip2/
**/ip2region/

# Package Lock Files (regenerated on install)
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml

# Maven Wrapper (optional, can be downloaded)
.mvn/

# Test Coverage Reports
**/coverage/

# Temporary Files
*.tmp
*.bak
*.swp
*~

# OS Generated Files
.Spotlight-V100
.Trashes
ehthumbs.db

# Deployment Scripts (managed on server)
docker/*.sh
docker/scripts/
